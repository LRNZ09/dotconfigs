// Prose in this repo is never hard-wrapped, so MD013 (line length) is disabled.
// Hard tabs in prose are still an error (MD010), but code blocks are exempted.
// Everything else stays enforced.
{
  "MD013": false,
  "MD010": {
    // Every hard tab is inside a code block: shell quoted from bin/, and
    // gitconfig snippets that have to match a file this repo indents with
    // tabs throughout.
    "code_blocks": false
  }
}
