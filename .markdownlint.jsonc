// Prose in this repo is never hard-wrapped. A hard tab in prose is an error.
// One exemption, for code blocks, which are quoted verbatim. Everything else
// stays enforced.
{
  "MD013": false,
  "MD010": {
    // Every hard tab is inside a code block: shell quoted from bin/, and
    // gitconfig snippets that have to match a file this repo indents with
    // tabs throughout.
    "code_blocks": false
  }
}
