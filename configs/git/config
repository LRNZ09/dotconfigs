# Core defaults and UI
[advice]
	skippedCherryPicks = false
	mergeConflict = false

[color]
	ui = auto

[column]
	ui = auto

[core]
	editor = code --wait

[help]
	autocorrect = prompt

[init]
	defaultBranch = main

# Branching, history, and commit flow
[branch]
	sort = -committerdate
	autoSetupMerge = simple

[tag]
	sort = version:refname

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	followTags = true

[fetch]
	prune = true
	pruneTags = true
	all = true

[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
	committerDateIsAuthorDate = true

[rerere]
	enabled = true
	autoupdate = true

[commit]
	verbose = true

[user]
	email = 13508373+LRNZ09@users.noreply.github.com
	name = Lorenzo Pieri

# Aliases
# fixup <commit>: commit staged changes as a fixup for <commit>, then immediately
# autosquash-rebase them in with no editor prompt. <commit> is resolved to a
# SHA up front so relative refs (HEAD~3, a branch name, ...) still point at the
# right commit after `git commit` moves HEAD.
[alias]
	fixup = "!f() { [ -z \"$1\" ] && { echo 'usage: git fixup <commit>' >&2; exit 1; }; hash=$(git rev-parse --verify \"$1^{commit}\") && git commit --fixup \"$hash\" && GIT_SEQUENCE_EDITOR=: git rebase -i --autosquash \"$hash^\"; }; f"

# Diff and merge tooling
[diff]
	tool = default-difftool
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true

[difftool "default-difftool"]
	cmd = code --wait --diff $LOCAL $REMOTE

[merge]
	tool = default-mergetool

[mergetool "default-mergetool"]
	cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED
	trustExitCode = false

[diff "lockb"]
	textconv = bun
	binary = true

# Credentials and host rewrites
# Every git (Apple's /usr/bin/git and Homebrew's) runs the same Apple-signed
# keychain helper. Each store resets the item's keychain partition list to the
# writing binary, so two helpers taking turns re-prompt forever, and Homebrew's
# ad-hoc-signed copy changes identity on every upgrade. The empty `helper`
# clears the `osxkeychain` that Apple git adds from its own system config.
[credential]
	helper =
	helper = cache --timeout 21600	# six hours
	helper = /Library/Developer/CommandLineTools/usr/libexec/git-core/git-credential-osxkeychain
	helper = oauth
	# Must stay last: stored credentials are checked before a new browser login.

# GitHub HTTPS auth via gh's token. `!gh` (not an absolute path) keeps this
# portable — gh is on $PATH via Homebrew (macOS) and Linuxbrew. The empty
# `helper` first clears the inherited keychain helper so gh wins for this host.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[url "https://bitbucket.org/"]
	insteadOf = ssh://git@bitbucket.org/

[url "git+https://bitbucket.org/"]
	insteadOf = git+ssh://git@bitbucket.org/

[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/

# The work-term guard, gitleaks, in every repo: refuses a commit or push that
# names a term on its private list or holds a secret
# (~/.config/gitleaks/work.toml, which extends default.toml's built-in secret
# rules). config-work switches it off under ~/Developer/work, and gitleaks-off
# in dotclaude. bin/gitleaks-hooks.bats tests these hooks.
[hook "gitleaks-msg"]
	event = commit-msg
	command = /opt/homebrew/bin/gitleaks dir --no-banner --redact -v --ignore-gitleaks-allow -c ~/.config/gitleaks/work.toml

[hook "gitleaks-staged"]
	event = pre-commit
	command = /opt/homebrew/bin/gitleaks git --staged --no-banner --redact -v --ignore-gitleaks-allow -c ~/.config/gitleaks/work.toml

# Each pushed commit the remote lacks, as .lefthook/pre-push/gitleaks.sh does
# (its comments say why each part is there), and their messages, which
# `gitleaks git` never reads: a cherry-pick, am or rebase runs no commit-msg
# hook. It ends in `:` because git appends "$@" to the command.
[hook "gitleaks-push"]
	event = pre-push
	command = "not=; case $1 in '' | *[[:space:]]* | *[][*?\\\\]*) ;; \
*) git remote | grep -qxF -- \"$1\" && not=\" --not --remotes=$1\" ;; esac; \
while read -r _ sha _ _; do \
case $sha in *[!0]*) ;; *) continue ;; esac; \
git rev-parse -q --verify \"$sha^{commit}\" >/dev/null || \
{ echo \"gitleaks-push: $sha is not a commit, and gitleaks scans only commits\" >&2; exit 1; }; \
/opt/homebrew/bin/gitleaks git --no-banner --redact -v --ignore-gitleaks-allow -c ~/.config/gitleaks/work.toml \
--log-opts=\"--no-color --no-ext-diff --no-textconv --root --diff-merges=first-parent $sha$not\" || exit 1; \
msgs=$(git log --no-show-signature --format=%B $sha$not) || exit 1; \
printf '%s' \"$msgs\" | /opt/homebrew/bin/gitleaks stdin --no-banner --redact -v --ignore-gitleaks-allow -c ~/.config/gitleaks/work.toml || exit 1; \
done; :"

# Per-machine identity (signing key, etc.) — see config-local.example
[include]
	path = config-local

# Conditional includes
[includeIf "gitdir:~/Developer/work/"]
	path = config-work

# The private dotclaude may name work terms too.
[includeIf "gitdir:~/Developer/LRNZ09/dotclaude/"]
	path = gitleaks-off
