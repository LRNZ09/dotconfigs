# Copy to `config-work` (git-ignored) to set your per-directory work identity.
# Loaded via the [includeIf "gitdir:~/Developer/work/"] rule in `config`.
[user]
	email = you@work.example
	signingkey = YOUR_GPG_KEY_ID

# Work repos may name work terms: switch the work-term guard, gitleaks, off here.
[hook "gitleaks-msg"]
	enabled = false
[hook "gitleaks-staged"]
	enabled = false
[hook "gitleaks-push"]
	enabled = false
